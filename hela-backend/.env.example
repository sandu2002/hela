# InsForge Backend-as-a-Service Credentials
INSFORGE_BASE_URL=https://<your-project-id>.us-east.insforge.app
INSFORGE_API_KEY=ik_your_api_key_here
INSFORGE_ANON_KEY=anon_your_anon_key_here

# AI Services
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek / OpenAI-Compatible Free Provider (Primary for Ask HELA)
# Supports OpenRouter (sk-or-...), NVIDIA NIM (nvapi-...), DeepSeek API (sk-...), or local Ollama
DEEPSEEK_API_KEY=your_openrouter_nvidia_or_deepseek_key
OPENROUTER_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
DEEPSEEK_FALLBACK_MODEL=openrouter/free

# Server Configuration
PORT=5000
NODE_ENV=development
